# Copy this file to .env and fill in your own values. Never put real keys in this file.

# --- AI (Snap Delivery Note). Without a key, Demo Mode uses the sample notes. ---
AI_API_KEY=
# Your provider's API address (ends in /v1 for most providers). Leave blank for OpenAI or Anthropic.
AI_BASE_URL=
# A model that can read images (vision), as named by your provider.
AI_MODEL=
# "openai" for OpenAI-compatible providers (most third-party APIs), or "anthropic". Auto-detected if blank.
AI_FORMAT=openai

# --- Supabase (shared database). Leave blank to keep data in this browser only. ---
# Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

PORT=3001

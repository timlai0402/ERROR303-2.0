# Copy this file to .env, then fill in your AI provider details.
# Without a key, StockWise runs in Demo Mode using the sample delivery notes.

AI_API_KEY=sk-jyV8r7dNV3rM532C_0eHjw
# Your provider's API address (ends in /v1 for most providers). Leave blank for OpenAI or Anthropic.
AI_BASE_URL=https://litellm.rapidscreen.io/v1
# A model that can read images (vision), as named by your provider.
AI_MODEL=gpt-5.5
# "openai" for OpenAI-compatible providers (most third-party APIs), or "anthropic". Auto-detected if blank.
AI_FORMAT=openai

PORT=3001
{
  "name": "stockwise",
  "version": "1.0.0",
  "private": true,
  "description": "StockWise — AI inventory web app for SMEs (FIFO, delivery-note scanning, smart reorder)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"vite\" \"node server/index.js\"",
    "dev:web": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "start": "npm run build && node server/index.js --prod",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/server": "^1.9.2",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  }
}
